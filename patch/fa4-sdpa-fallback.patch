+def _sdpa_block_attention(q_flat, packed_k, packed_v, cu_q, text_length):
+    """Per-frame-block cross-attention via SDPA (the ROCm fallback path).
+
+    Layout contract (matches ``build_layout``):
+    - ``q_flat`` / ``packed_k`` / ``packed_v``: ``[T, H, D]`` flat tokens;
+      K tokens for block ``j`` live at ``[j*L, (j+1)*L)`` with
+      ``L = text_length``.
+    - ``cu_q``: ``[B+1]`` cumulative offsets; query tokens for block ``j``
+      live at ``[cu_q[j], cu_q[j+1])``.
+    - For batch 1 (the only supported case) K/V are packed contiguously
+      across frame blocks, so token ``t`` of the j-th query block attends
+      to K/V of its corresponding text segment — the same mapping the
+      FA4 varlen kernel produces with ``cu_k = j*L``.
+    """
+    import torch
+    import torch.nn.functional as F
+
+    cu = [int(x) for x in cu_q.tolist()]
+    out = torch.empty_like(q_flat)
+    for j in range(len(cu) - 1):
+        a, b = cu[j], cu[j + 1]
+        if b <= a:
+            continue
+        kj0, kj1 = j * text_length, (j + 1) * text_length
+        qj = q_flat[a:b].transpose(0, 1)      # [H, n, D]
+        kj = packed_k[kj0:kj1].transpose(0, 1)
+        vj = packed_v[kj0:kj1].transpose(0, 1)
+        out[a:b] = F.scaled_dot_product_attention(qj, kj, vj).transpose(0, 1)
+    return out
+
